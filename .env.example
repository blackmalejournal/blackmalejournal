# ──────────────────────────────────────────────
# The Black Male Journal — Environment Variables
# Copy this file to .env.local and fill in your values.
# See docs/ops/env-vars.md for full documentation.
# ──────────────────────────────────────────────

# ── Supabase (required) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (required) ────────────────────────
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_BASIC_PRICE_ID=price_your-basic-id
STRIPE_PREMIUM_PRICE_ID=price_your-premium-id

# ── Resend (optional — contact form email delivery) ──
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
CONTACT_TO_EMAIL=founder@yourdomain.com

# ── Site Config ──────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/your-number

# ── Analytics (optional) ─────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=blackmalejournal.org

# ── E2E (optional — Playwright authenticated suites) ──
# ⚠️  TEST ONLY — use seed-test-users.sql to create these accounts locally/staging.
# Rotate all passwords before any production deploy.
# E2E_ADMIN_EMAIL=admin@bmj.test
# E2E_ADMIN_PASSWORD=TestOnly!1
# E2E_MEMBER_EMAIL=free@bmj.test
# E2E_MEMBER_PASSWORD=TestOnly!1
# E2E_BASIC_EMAIL=basic@bmj.test
# E2E_BASIC_PASSWORD=TestOnly!1
# E2E_PREMIUM_EMAIL=premium@bmj.test
# E2E_PREMIUM_PASSWORD=TestOnly!1
