{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "moduleResolution": "node"
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
